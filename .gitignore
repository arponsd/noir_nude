# Production
build/
dist/

# Environment — never commit real secrets. .env.example is whitelisted below.
.env
.env.*
!.env.example
!.env.example.*
# Belt-and-braces: any file named with the word "secret" stays out
*.secret
*.secret.*
secrets.json
credentials.json

# Test output
coverage/
playwright-report/
test-results/
playwright/.cache/
playwright/.auth/
.nyc_output/

# Lighthouse CI
.lighthouseci/
lhci-reports/

# Bundle analysis
/analyze/
.next/analyze/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
Icon?

